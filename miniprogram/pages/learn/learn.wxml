<!-- 默认展示 Sprint 1 测试词卡；Unit 1 核心任务由查询模式单独渲染。 -->
<view wx:if="{{courseLibraryMode}}" class="learn-page">
  <view class="learn-hero">
    <text class="hero-kicker">教材知识预览</text>
    <text class="hero-title">{{knowledgeTitle}}</text>
    <text class="hero-subtitle">{{knowledgeTopic}}</text>
    <text class="hero-count">{{knowledgeVocabularyCount}} 个词条 · {{knowledgeSentenceCount}} 条表达</text>
  </view>

  <view class="knowledge-unit-switch">
    <button class="knowledge-unit {{isWelcomeKnowledge ? 'selected' : ''}}" data-unit-id="wj-g3-v1:welcome" bindtap="selectKnowledgeUnit">Welcome</button>
    <button class="knowledge-unit {{isUnit1Knowledge ? 'selected' : ''}}" data-unit-id="wj-g3-v1:unit-1" bindtap="selectKnowledgeUnit" disabled="{{!unit1KnowledgeUnlocked}}">Unit 1</button>
  </view>

  <view class="knowledge-note">
    <text>这里可以随时查看课程知识；每日任务由课程冒险单独安排。</text>
    <text>{{knowledgeReleaseHint}}</text>
    <text>课程进度由团团悄悄记下；这里显示当前开放的知识卡。</text>
  </view>

  <view class="knowledge-section">
    <text class="knowledge-heading">词汇</text>
    <view class="knowledge-row" wx:for="{{knowledgeVocabulary}}" wx:key="id">
      <view class="knowledge-copy">
        <text class="word-english">{{item.english}}</text>
        <text wx:if="{{item.phonetic}}" class="word-phonetic">{{item.phonetic}}</text>
        <text wx:if="{{item.printedEnglish && item.printedEnglish !== item.english}}" class="word-chinese">{{item.printedEnglish}}</text>
        <text class="word-chinese">{{item.chinese}}</text>
      </view>
      <button class="pronunciation-button" data-word-id="{{item.id}}" bindtap="playVocabularyAudio" aria-label="播放{{item.english}}发音">🔊</button>
      <text wx:if="{{item.learningGroup}}" class="knowledge-tag">{{item.learningGroup}}</text>
    </view>
  </view>

  <view class="knowledge-section">
    <text class="knowledge-heading">句型与表达</text>
    <view class="knowledge-row sentence-row" wx:for="{{knowledgeSentences}}" wx:key="id">
      <text class="sentence-text">{{item.text}}</text>
      <text class="word-chinese">{{item.chinese || item.meaning}}</text>
    </view>
  </view>

  <text wx:if="{{pronunciationMessage}}" class="pronunciation-message">{{pronunciationMessage}}</text>
  <button class="back-button" bindtap="backHome">回到树屋</button>
</view>

<view wx:elif="{{welcomeMode}}" class="learn-page welcome-adventure-page">
  <view class="learn-hero">
    <text class="hero-kicker">Welcome 冒险 · 第 {{welcomeSessionNumber}} / {{welcomeTotalSessions}} 节</text>
    <text wx:if="{{welcomeTotalSteps}}" class="hero-footnote">挑战 {{welcomeStepNumber}} / {{welcomeTotalSteps}}</text>
    <text class="hero-title">{{welcomeTitle}}</text>
    <text class="hero-subtitle">跟着团团找线索，用英语完成小任务。</text>
    <text class="hero-count">今天还可以和团团互动 {{interactionsRemaining}} / {{maxDailyInteractions}} 次</text>
    <text class="hero-footnote">{{interactionRecoveryHint}}</text>
    <text class="hero-footnote">Welcome · 已完成 {{welcomeCompletedSessions}} / {{welcomeTotalSessions}} 节</text>
  </view>

  <view class="welcome-adventure-card">
    <view class="welcome-goal-box">
      <text class="welcome-card-kicker">本节冒险目标</text>
      <text class="welcome-goal-text">{{welcomeAdventureGoal}}</text>
    </view>
    <view class="welcome-scene-stage">
      <image class="welcome-scene-background" src="{{welcomeSceneBackground}}" mode="aspectFill" aria-label="树屋旁的冒险场景" />
      <image class="welcome-scene-star" src="{{welcomeStarImage}}" mode="aspectFit" aria-label="星星徽章线索" />
      <view class="welcome-stage-character">
        <image wx:if="{{!tuantuanImageFailed}}" class="welcome-stage-tuantu-image" src="{{tuantuanVisual.src}}" mode="aspectFit" binderror="onWelcomeTuantuanImageError" aria-label="{{tuantuanVisual.alt}}" />
        <text wx:else class="welcome-stage-fallback">团团</text>
      </view>
      <view class="welcome-speech-bubble">
        <text class="welcome-tuantu-name">团团</text>
        <text class="welcome-tuantu-line">{{tuantuanMessage}}</text>
      </view>
    </view>
    <text class="welcome-star-status">⭐ 当前星星：{{welcomeStars}}</text>
  </view>

  <view wx:if="{{welcomeStatus === 'playing' && welcomeStep}}" class="welcome-task-card">
    <text class="welcome-step-title">{{welcomeStep.prompt}}</text>
    <view wx:if="{{welcomeStep.kind === 'letter-match'}}" class="welcome-letter-challenge">
      <text class="welcome-letter-target">{{welcomeStep.targetLetter}}</text>
      <text class="welcome-letter-hint">找到它的小写字母朋友</text>
    </view>
    <view wx:if="{{welcomeStep.kind === 'recognize-letters'}}" class="welcome-letter-grid">
      <button wx:for="{{welcomeStep.letters}}" wx:key="value" class="welcome-letter {{item.selected ? 'selected' : ''}}" data-letter="{{item.value}}" bindtap="tapWelcomeLetter" disabled="{{item.selected}}">
        <text>{{item.value}} {{item.lowercase}}</text>
      </button>
    </view>
    <view wx:if="{{welcomeStep.kind === 'greeting-input'}}" class="welcome-greeting-input">
      <view wx:for="{{welcomeStep.vocabulary}}" wx:key="id" class="welcome-greeting-word">
        <view class="welcome-greeting-word-copy">
          <text class="welcome-greeting-word-text">{{item.english}}</text>
          <text wx:if="{{item.phonetic}}" class="welcome-greeting-phonetic">{{item.phonetic}}</text>
          <text class="welcome-greeting-heard">{{item.audioPlayed ? '已经听过啦' : '点一下听发音'}}</text>
        </view>
        <button class="welcome-greeting-audio" data-word-id="{{item.id}}" bindtap="playWelcomeGreetingAudio" disabled="{{choiceBusy}}">🔊</button>
      </view>
      <button class="welcome-audio-button" bindtap="completeWelcomeGreetingInputStep" disabled="{{choiceBusy || !welcomeStep.inputReady}}">听好啦，开始听辨</button>
      <text class="welcome-audio-hint">两张问候卡都听过后，才会开始找声音。</text>
    </view>
    <view wx:if="{{welcomeStep.kind === 'sentence-build'}}" class="welcome-sentence-build">
      <view class="welcome-sentence-result">
        <text wx:if="{{!welcomeStep.hasSelectedTiles}}" class="welcome-sentence-placeholder">把词块按顺序放进句子里</text>
        <text wx:for="{{welcomeStep.selectedTiles}}" wx:key="id" class="welcome-sentence-piece">{{item.label}}</text>
      </view>
      <view class="welcome-sentence-tiles">
        <button wx:for="{{welcomeStep.availableTiles}}" wx:key="id" class="welcome-sentence-tile" data-tile-id="{{item.id}}" bindtap="chooseSentenceBuildTile" disabled="{{choiceBusy}}">{{item.label}}</button>
      </view>
    </view>
    <button wx:if="{{welcomeStep.kind === 'listen-and-identify'}}" class="welcome-audio-button" bindtap="playWelcomeAudio" disabled="{{choiceBusy}}">🔊 听米米说</button>
    <text wx:if="{{welcomeStep.kind === 'listen-and-identify' && !welcomeAudioPlayed}}" class="welcome-audio-hint">先听米米的问候，再选一张声音相同的卡片。</text>
    <button wx:if="{{welcomeStep.kind === 'companion-interaction'}}" class="welcome-companion-button" bindtap="interactForWelcome" disabled="{{choiceBusy}}">{{welcomeStep.buttonLabel}}</button>
    <button wx:for="{{welcomeStep.options}}" wx:key="id" class="welcome-option" data-option-id="{{item.id}}" bindtap="chooseWelcomeOption" disabled="{{choiceBusy || (welcomeStep.requireAudioPlayed && !welcomeAudioPlayed)}}">
      <text class="welcome-option-label">{{item.label}}</text>
    </button>
    <text wx:if="{{welcomeMessage}}" class="welcome-message">{{welcomeMessage}}</text>
    <text wx:if="{{pronunciationMessage}}" class="pronunciation-message">{{pronunciationMessage}}</text>
  </view>
  <view wx:elif="{{welcomeStatus === 'completed'}}" class="welcome-task-card welcome-completion-card">
    <text class="welcome-step-title">{{welcomeMessage}}</text>
    <view wx:if="{{welcomeRewardMessage}}" class="welcome-reward-result">
      <text class="welcome-reward-icon">⭐</text>
      <text class="welcome-reward-copy">{{welcomeRewardMessage}}</text>
      <text class="welcome-star-count">现在有 {{welcomeStars}} 颗星星</text>
    </view>
    <view class="welcome-companion-row welcome-completion-companion">
      <view class="welcome-tuantu-avatar">
        <image wx:if="{{!tuantuanImageFailed}}" class="welcome-tuantu-image" src="{{tuantuanVisual.src}}" mode="aspectFit" binderror="onWelcomeTuantuanImageError" aria-label="{{tuantuanVisual.alt}}" />
        <text wx:else class="welcome-tuantu-fallback">团团</text>
      </view>
      <view class="welcome-tuantu-copy">
        <text class="welcome-tuantu-name">团团</text>
        <text class="welcome-tuantu-line">{{tuantuanMessage}}</text>
      </view>
    </view>
    <button class="back-button" bindtap="backToStory">带着星星继续冒险</button>
  </view>
  <view wx:else class="welcome-task-card">
    <text class="welcome-message">{{welcomeMessage}}</text>
    <button class="back-button" bindtap="backToStory">回到团团身边</button>
  </view>
</view>
<view wx:elif="{{unit1Mode}}" class="learn-page">
  <view class="learn-hero">
    <text class="hero-kicker">Unit 1 · 核心学习任务</text>
    <text class="hero-title">{{unit1Title}}</text>
    <text class="hero-subtitle">先看团团的介绍，再选一张合适的句型卡。</text>
    <text wx:if="{{unit1Keyword}}" class="hero-count">{{unit1Keyword.english}} · {{unit1Keyword.chinese}}</text>
  </view>

  <view wx:if="{{unit1Status === 'playing'}}" class="unit1-task-card">
    <text class="unit1-prompt">{{unit1Prompt}}</text>
    <text class="unit1-support">{{unit1Support}}</text>
    <button wx:for="{{unit1Options}}" wx:key="id" class="unit1-option" data-option-id="{{item.id}}" bindtap="chooseIntroduction" disabled="{{choiceBusy}}">
      {{item.label}}
    </button>
    <text class="unit1-message">{{unit1Message}}</text>
  </view>
  <view wx:elif="{{unit1Status === 'completed'}}" class="unit1-task-card">
    <text class="unit1-prompt">{{unit1Message}}</text>
    <button class="back-button" bindtap="backToStory">回到团团身边</button>
  </view>
  <view wx:else class="unit1-task-card">
    <text class="unit1-message">{{unit1Message}}</text>
    <button class="back-button" bindtap="backToStory">回到故事</button>
  </view>
</view>

<view wx:else class="learn-page">
  <view class="learn-hero">
    <text class="hero-kicker">树屋小冒险</text>
    <text class="hero-title">今天认识这 {{total}} 个词</text>
    <text class="hero-subtitle">轻轻点一下，记下你已经认识的单词。</text>
    <text class="hero-count">已认识 {{completed}} / {{total}}</text>
  </view>

  <view class="word-list">
    <view class="word-card" wx:for="{{words}}" wx:key="id">
      <view class="word-copy">
        <text class="word-english">{{item.english}}</text>
        <text wx:if="{{item.phonetic}}" class="word-phonetic">{{item.phonetic}}</text>
        <text class="word-chinese">{{item.chinese}}</text>
      </view>
      <button class="pronunciation-button" data-word-id="{{item.id}}" bindtap="playVocabularyAudio" aria-label="播放{{item.english}}发音">🔊</button>
      <button class="mark-button {{item.learned ? 'is-learned' : ''}}" data-word-id="{{item.id}}" bindtap="markLearned" disabled="{{item.learned}}">
        {{item.learned ? '已认识' : '我认识了'}}
      </button>
    </view>
  </view>
  <text wx:if="{{pronunciationMessage}}" class="pronunciation-message">{{pronunciationMessage}}</text>

  <button class="back-button" bindtap="backHome">返回树屋</button>
</view>
