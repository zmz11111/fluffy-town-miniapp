/* 学习页以原生文字与色块为主；Welcome 只引用项目登记的场景和角色资源。 */
.learn-page { padding: 34rpx 28rpx 60rpx; }
.learn-hero { display: flex; flex-direction: column; padding: 38rpx 35rpx; border-radius: 32rpx; background: #dcebd6; }
.hero-kicker { color: #628267; font-size: 25rpx; font-weight: 600; }
.hero-title { margin-top: 13rpx; color: #36553f; font-size: 42rpx; font-weight: 700; }
.hero-subtitle { margin-top: 13rpx; color: #647969; font-size: 25rpx; line-height: 1.5; }
.hero-count { margin-top: 21rpx; color: #4c7855; font-size: 28rpx; font-weight: 700; }
.hero-footnote { margin-top: 8rpx; color: #778677; font-size: 23rpx; }
.word-list { margin-top: 28rpx; }
.word-card { display: flex; align-items: center; justify-content: space-between; min-height: 118rpx; margin-bottom: 18rpx; padding: 18rpx 24rpx 18rpx 30rpx; border-radius: 25rpx; background: #fffdf7; }
.word-copy { display: flex; flex-direction: column; }
.word-english { color: #344f3c; font-size: 36rpx; font-weight: 700; }
.word-phonetic { margin-top: 4rpx; color: #728075; font-size: 23rpx; letter-spacing: 1rpx; }
.word-chinese { margin-top: 4rpx; color: #7a887c; font-size: 24rpx; }
.mark-button { width: 170rpx; height: 70rpx; margin: 0; border-radius: 22rpx; background: #e5efdf; color: #4c7a55; font-size: 24rpx; line-height: 70rpx; }
.mark-button.is-learned { background: #eef0eb; color: #87948a; }
.back-button { margin-top: 38rpx; height: 88rpx; border-radius: 26rpx; background: #5a8f69; color: #fff; font-size: 29rpx; line-height: 88rpx; }
.welcome-task-card { display: flex; flex-direction: column; margin-top: 28rpx; padding: 32rpx 28rpx; border-radius: 30rpx; background: #fffdf7; }
.welcome-step-title { color: #344f3c; font-size: 32rpx; font-weight: 700; line-height: 1.55; }
.welcome-option { display: flex; flex-direction: column; justify-content: center; min-height: 90rpx; margin: 20rpx 0 0; padding: 14rpx 20rpx; border: 3rpx solid #dce8d9; border-radius: 22rpx; background: #f4f9ef; color: #36553f; line-height: 1.4; }
.welcome-option-label { font-size: 30rpx; font-weight: 700; }
.welcome-message { margin-top: 22rpx; color: #53715a; font-size: 25rpx; line-height: 1.5; }
.unit1-task-card { display: flex; flex-direction: column; margin-top: 28rpx; padding: 32rpx 28rpx; border-radius: 30rpx; background: #fffdf7; }
.unit1-prompt { color: #344f3c; font-size: 32rpx; font-weight: 700; line-height: 1.5; }
.unit1-support { margin-top: 16rpx; color: #718273; font-size: 25rpx; line-height: 1.5; }
.unit1-option { min-height: 88rpx; margin: 22rpx 0 0; border: 3rpx solid #dce8d9; border-radius: 22rpx; background: #f4f9ef; color: #36553f; font-size: 31rpx; font-weight: 600; }
.unit1-message { margin-top: 24rpx; color: #53715a; font-size: 25rpx; line-height: 1.5; }
.knowledge-unit-switch { display: flex; margin: 24rpx 0 14rpx; }
.knowledge-unit { flex: 1; margin: 0 8rpx; border-radius: 22rpx; background: #eef3ea; color: #59725e; font-size: 26rpx; }
.knowledge-unit.selected { background: #5a8f69; color: #fff; }
.knowledge-note { display: flex; flex-direction: column; gap: 8rpx; margin: 18rpx 4rpx 24rpx; color: #78877b; font-size: 23rpx; line-height: 1.5; }
.knowledge-section { margin-top: 30rpx; }
.knowledge-heading { display: block; margin: 0 0 12rpx 6rpx; color: #48664d; font-size: 29rpx; font-weight: 700; }
.knowledge-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; margin-bottom: 12rpx; padding: 16rpx 24rpx; border-radius: 22rpx; background: #fffdf7; }
.knowledge-copy { display: flex; flex: 1; flex-direction: column; }
.pronunciation-button { flex: none; min-width: 72rpx; height: 64rpx; margin: 0 12rpx; padding: 0 12rpx; border-radius: 22rpx; background: #e8f0e3; color: #4e7457; font-size: 23rpx; line-height: 64rpx; }
.pronunciation-message { display: block; margin: 14rpx 8rpx; color: #8a7357; font-size: 22rpx; line-height: 1.4; }
.knowledge-tag { margin-left: 12rpx; color: #809181; font-size: 21rpx; }
.sentence-row,.objective-row { display: flex; align-items: flex-start; flex-direction: column; }
.sentence-text { color: #344f3c; font-size: 28rpx; font-weight: 600; line-height: 1.45; }
.welcome-word-list,.welcome-sentence-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.welcome-word { display: flex; flex: 1; min-width: 145rpx; flex-direction: column; padding: 18rpx; border-radius: 20rpx; background: #f2f7ee; }
.welcome-word .pronunciation-button { align-self: flex-start; margin: 12rpx 0 0; }
.welcome-word-english { color: #36553f; font-size: 29rpx; font-weight: 700; }
.welcome-word-chinese { margin-top: 4rpx; color: #718273; font-size: 23rpx; }
.welcome-sentence { padding: 12rpx 17rpx; border-radius: 18rpx; background: #f2f7ee; color: #36553f; font-size: 25rpx; }
.welcome-letter-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; }
.welcome-letter { box-sizing: border-box; width: 22%; height: 82rpx; margin: 0 0 12rpx; border: 2rpx solid #dce8d9; border-radius: 18rpx; background: #f4f9ef; color: #36553f; font-size: 25rpx; font-weight: 700; }
.welcome-letter.selected { background: #5a8f69; color: #fff; }

/* Welcome 冒险卡突出孩子的目标、伙伴对话和可操作挑战。 */
.welcome-adventure-card { display: flex; flex-direction: column; margin-top: 22rpx; padding: 24rpx; border: 2rpx solid #d7e6d2; border-radius: 28rpx; background: #f3f8ef; }
.welcome-goal-box { display: flex; flex-direction: column; padding: 18rpx 20rpx; border-radius: 20rpx; background: #fffdf7; }
.welcome-card-kicker { color: #748b77; font-size: 22rpx; font-weight: 600; }
.welcome-goal-text { margin-top: 7rpx; color: #36553f; font-size: 27rpx; font-weight: 700; line-height: 1.45; }
.welcome-companion-row { display: flex; align-items: center; margin-top: 20rpx; padding: 14rpx; border-radius: 22rpx; background: #fffdf7; }
.welcome-tuantu-avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; overflow: hidden; border-radius: 50%; background: #e8f0e3; }
.welcome-tuantu-image { width: 100%; height: 100%; }
.welcome-tuantu-fallback { color: #4f7457; font-size: 27rpx; font-weight: 700; }
.welcome-tuantu-copy { display: flex; flex: 1; flex-direction: column; margin-left: 16rpx; }
.welcome-tuantu-name { color: #56765d; font-size: 23rpx; font-weight: 700; }
.welcome-tuantu-line { margin-top: 5rpx; color: #405b46; font-size: 24rpx; line-height: 1.45; }
.welcome-star-status { align-self: flex-end; margin-top: 15rpx; color: #92743e; font-size: 23rpx; font-weight: 700; }
.welcome-audio-button,.welcome-companion-button { height: 84rpx; margin-top: 20rpx; border: 2rpx solid #d4e4ce; border-radius: 22rpx; background: #eaf3e4; color: #42684c; font-size: 28rpx; font-weight: 700; line-height: 80rpx; }
.welcome-audio-hint { margin-top: 12rpx; color: #7a846f; font-size: 22rpx; text-align: center; }
.welcome-greeting-input { display: flex; flex-direction: column; margin-top: 18rpx; }
.welcome-greeting-word + .welcome-greeting-word { margin-top: 12rpx; }
.welcome-greeting-word { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; border: 2rpx solid #dce9d6; border-radius: 20rpx; background: #fffdf7; }
.welcome-greeting-word-copy { display: flex; flex-direction: column; }
.welcome-greeting-word-text { color: #36553f; font-size: 34rpx; font-weight: 800; }
.welcome-greeting-phonetic { margin-top: 4rpx; color: #7a887b; font-size: 23rpx; }
.welcome-greeting-heard { margin-top: 6rpx; color: #79917a; font-size: 21rpx; }
.welcome-greeting-audio { width: 82rpx; height: 72rpx; margin: 0; border-radius: 18rpx; background: #eaf3e4; color: #42684c; font-size: 30rpx; line-height: 68rpx; }
.welcome-sentence-build { margin-top: 18rpx; }
.welcome-sentence-result { display: flex; flex-wrap: wrap; align-items: center; min-height: 86rpx; padding: 12rpx; border: 2rpx dashed #c8dbc1; border-radius: 20rpx; background: #fffdf7; }
.welcome-sentence-placeholder { color: #849184; font-size: 23rpx; }
.welcome-sentence-piece { margin: 4rpx; padding: 11rpx 15rpx; border-radius: 14rpx; background: #eaf3e4; color: #36553f; font-size: 26rpx; font-weight: 700; }
.welcome-sentence-tiles { display: flex; flex-wrap: wrap; justify-content: center; margin: 9rpx -6rpx 0; }
.welcome-sentence-tile { margin: 6rpx; padding: 0 23rpx; border: 2rpx solid #d9e5d4; border-radius: 18rpx; background: #f8fbf5; color: #42684c; font-size: 27rpx; }

.welcome-sentence-card { display: flex; flex-direction: column; padding: 12rpx 17rpx; border-radius: 18rpx; background: #f2f7ee; }
.welcome-sentence-chinese { margin-top: 5rpx; color: #718273; font-size: 22rpx; }
.welcome-letter-challenge { display: flex; align-items: center; justify-content: center; flex-direction: column; margin-top: 18rpx; padding: 22rpx; border-radius: 22rpx; background: #f2f7ee; }
.welcome-letter-target { color: #36553f; font-size: 68rpx; font-weight: 800; line-height: 1.1; }
.welcome-letter-hint { margin-top: 8rpx; color: #718273; font-size: 23rpx; }
.welcome-completion-card { border: 2rpx solid #e5d7a8; background: #fffaf0; }
.welcome-reward-result { display: flex; align-items: center; flex-direction: column; margin-top: 24rpx; padding: 24rpx; border-radius: 24rpx; background: #fff2c8; }
.welcome-reward-icon { font-size: 58rpx; line-height: 1.1; }
.welcome-reward-copy { margin-top: 10rpx; color: #806126; font-size: 27rpx; font-weight: 700; text-align: center; line-height: 1.45; }
.welcome-star-count { margin-top: 8rpx; color: #917744; font-size: 23rpx; }
.welcome-completion-companion { border: 2rpx solid #f0e3bf; }

/* Welcome 场景与短暂动画由独立展示组件管理，不使用持续循环动效。 */
