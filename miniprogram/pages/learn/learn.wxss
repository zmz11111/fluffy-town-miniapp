/* 单词预览页仅使用原生文字与色块，避免接入未授权资源。 */
.learn-page { padding: 34rpx 28rpx 60rpx; }
.learn-hero { display: flex; flex-direction: column; padding: 38rpx 35rpx; border-radius: 32rpx; background: #dcebd6; }
.hero-kicker { color: #628267; font-size: 25rpx; font-weight: 600; }
.hero-title { margin-top: 13rpx; color: #36553f; font-size: 42rpx; font-weight: 700; }
.hero-subtitle { margin-top: 13rpx; color: #647969; font-size: 25rpx; line-height: 1.5; }
.hero-count { margin-top: 21rpx; color: #4c7855; font-size: 28rpx; font-weight: 700; }
.word-list { margin-top: 28rpx; }
.word-card { display: flex; align-items: center; justify-content: space-between; min-height: 118rpx; margin-bottom: 18rpx; padding: 18rpx 24rpx 18rpx 30rpx; border-radius: 25rpx; background: #fffdf7; }
.word-copy { display: flex; flex-direction: column; }
.word-english { color: #344f3c; font-size: 36rpx; font-weight: 700; }
.word-chinese { margin-top: 4rpx; color: #7a887c; font-size: 24rpx; }
.mark-button { width: 170rpx; height: 70rpx; margin: 0; border-radius: 22rpx; background: #e5efdf; color: #4c7a55; font-size: 24rpx; line-height: 70rpx; }
.mark-button.is-learned { background: #eef0eb; color: #87948a; }
.back-button { margin-top: 38rpx; height: 88rpx; border-radius: 26rpx; background: #5a8f69; color: #fff; font-size: 29rpx; line-height: 88rpx; }
