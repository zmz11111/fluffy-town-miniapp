/* 单词预览页仅使用原生文字与色块，避免接入未授权资源。 */
.learn-page { padding: 34rpx 28rpx 60rpx; }
.learn-hero { display: flex; flex-direction: column; padding: 38rpx 35rpx; border-radius: 32rpx; background: #dcebd6; }
.hero-kicker { color: #628267; font-size: 25rpx; font-weight: 600; }
.hero-title { margin-top: 13rpx; color: #36553f; font-size: 42rpx; font-weight: 700; }
.hero-subtitle { margin-top: 13rpx; color: #647969; font-size: 25rpx; line-height: 1.5; }
.hero-count { margin-top: 21rpx; color: #4c7855; font-size: 28rpx; font-weight: 700; }
.word-list { margin-top: 28rpx; }
.word-card { display: flex; align-items: center; justify-content: space-between; min-height: 118rpx; margin-bottom: 18rpx; padding: 18rpx 24rpx 18rpx 30rpx; border-radius: 25rpx; background: #fffdf7; }
.word-copy { display: flex; flex-direction: column; }
.word-english { color: #344f3c; font-size: 36rpx; font-weight: 700; }
.word-chinese { margin-top: 4rpx; color: #7a887c; font-size: 24rpx; }
.mark-button { width: 170rpx; height: 70rpx; margin: 0; border-radius: 22rpx; background: #e5efdf; color: #4c7a55; font-size: 24rpx; line-height: 70rpx; }
.mark-button.is-learned { background: #eef0eb; color: #87948a; }
.back-button { margin-top: 38rpx; height: 88rpx; border-radius: 26rpx; background: #5a8f69; color: #fff; font-size: 29rpx; line-height: 88rpx; }
.welcome-task-card { display: flex; flex-direction: column; margin-top: 28rpx; padding: 32rpx 28rpx; border-radius: 30rpx; background: #fffdf7; }
.welcome-step-title { color: #344f3c; font-size: 32rpx; font-weight: 700; line-height: 1.55; }
.welcome-option { display: flex; flex-direction: column; justify-content: center; min-height: 90rpx; margin: 20rpx 0 0; padding: 14rpx 20rpx; border: 3rpx solid #dce8d9; border-radius: 22rpx; background: #f4f9ef; color: #36553f; line-height: 1.4; }
.welcome-option-label { font-size: 30rpx; font-weight: 700; }
.welcome-option-translation { margin-top: 6rpx; color: #718273; font-size: 24rpx; }
.welcome-message { margin-top: 22rpx; color: #53715a; font-size: 25rpx; line-height: 1.5; }
.unit1-task-card { display: flex; flex-direction: column; margin-top: 28rpx; padding: 32rpx 28rpx; border-radius: 30rpx; background: #fffdf7; }
.unit1-prompt { color: #344f3c; font-size: 32rpx; font-weight: 700; line-height: 1.5; }
.unit1-support { margin-top: 16rpx; color: #718273; font-size: 25rpx; line-height: 1.5; }
.unit1-option { min-height: 88rpx; margin: 22rpx 0 0; border: 3rpx solid #dce8d9; border-radius: 22rpx; background: #f4f9ef; color: #36553f; font-size: 31rpx; font-weight: 600; }
.unit1-message { margin-top: 24rpx; color: #53715a; font-size: 25rpx; line-height: 1.5; }
.knowledge-unit-switch { display: flex; margin: 24rpx 0 14rpx; }
.knowledge-unit { flex: 1; margin: 0 8rpx; border-radius: 22rpx; background: #eef3ea; color: #59725e; font-size: 26rpx; }
.knowledge-unit.selected { background: #5a8f69; color: #fff; }
.knowledge-note { display: flex; flex-direction: column; gap: 8rpx; margin: 18rpx 4rpx 24rpx; color: #78877b; font-size: 23rpx; line-height: 1.5; }
.knowledge-section { margin-top: 30rpx; }
.knowledge-heading { display: block; margin: 0 0 12rpx 6rpx; color: #48664d; font-size: 29rpx; font-weight: 700; }
.knowledge-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; margin-bottom: 12rpx; padding: 16rpx 24rpx; border-radius: 22rpx; background: #fffdf7; }
.knowledge-copy { display: flex; flex: 1; flex-direction: column; }
.knowledge-tag { margin-left: 12rpx; color: #809181; font-size: 21rpx; }
.sentence-row,.objective-row { display: flex; align-items: flex-start; flex-direction: column; }
.sentence-text { color: #344f3c; font-size: 28rpx; font-weight: 600; line-height: 1.45; }
.welcome-word-list,.welcome-sentence-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.welcome-word { display: flex; flex: 1; min-width: 145rpx; flex-direction: column; padding: 18rpx; border-radius: 20rpx; background: #f2f7ee; }
.welcome-word-english { color: #36553f; font-size: 29rpx; font-weight: 700; }
.welcome-word-chinese { margin-top: 4rpx; color: #718273; font-size: 23rpx; }
.welcome-sentence { padding: 12rpx 17rpx; border-radius: 18rpx; background: #f2f7ee; color: #36553f; font-size: 25rpx; }
