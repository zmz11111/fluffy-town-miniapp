<!-- 故事页展示管理器对白和独立角色头像，页面不写游戏进度。 -->
<view class="story-page">
  <view class="chapter-tag">{{chapterLabel}} · {{title}}</view>
  <view wx:if="{{!completed}}" class="story-card">
    <view class="scene-count">场景 {{sceneNumber}} / {{sceneTotal}}</view>
    <view class="scene-title">{{sceneTitle}}</view>
    <view class="scene-art">
      <image wx:if="{{!sceneImageFailed}}" class="scene-background" src="{{sceneSrc}}" mode="aspectFill" binderror="onSceneImageError" aria-label="{{sceneAlt}}" />
      <text wx:if="{{sceneImageFailed}}">🌳 毛茸茸树屋 ⭐</text>
      <view wx:for="{{sceneCharacters}}" wx:key="characterId" class="scene-character scene-character-{{item.position}} {{item.speaking ? 'is-speaking' : ''}}">
        <image wx:if="{{!item.imageFailed}}" src="{{item.src}}" mode="aspectFit" data-character-id="{{item.characterId}}" binderror="onSceneCharacterError" aria-label="{{item.alt}}" />
        <text wx:else>{{item.fallbackText}}</text>
      </view>
    </view>
    <view class="speaker-row">
      <view wx:if="{{avatarSrc}}" class="speaker-avatar">
        <image wx:if="{{!avatarImageFailed}}" src="{{avatarSrc}}" mode="aspectFit" binderror="onAvatarImageError" aria-label="{{avatarAlt}}" />
        <text wx:else>{{avatarFallbackText}}</text>
      </view>
      <view class="speaker">{{speaker}}</view>
    </view>
    <view class="dialogue">{{dialogue}}</view>
    <view class="task-status">{{taskStatus}}</view>
    <view class="next-step">{{nextStep}}</view>
    <button class="primary" bindtap="next" disabled="{{actionBusy}}">{{actionLabel}}</button>
  </view>
  <view wx:else class="story-card finish">
    <view class="finish-icon">⭐</view>
    <view class="scene-title">{{completionTitle}}</view>
    <view class="dialogue">团团：{{completionMessage}}</view>
    <view wx:if="{{gameRewardStars > 0}}" class="reward-detail">线索任务：+{{gameRewardStars}} ⭐</view>
    <view wx:if="{{chapterRewardStars > 0}}" class="reward-detail">本章奖励：+{{chapterRewardStars}} ⭐</view>
    <view wx:if="{{showMimiUnlockReward}}" class="reward-detail">新伙伴：米米加入啦！</view>
    <view class="reward-total">现在共有 {{stars}} 颗星星</view>
    <view class="next-step">{{nextStep}}</view>
    <button class="primary" bindtap="finishAction" disabled="{{actionBusy}}">{{finishActionLabel}}</button>
  </view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
</view>
