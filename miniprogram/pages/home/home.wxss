/* 首页场景与团团均为原创占位图形，后续可替换为已授权素材。 */
.home { padding: 32rpx 28rpx 60rpx; }
.welcome { display: flex; flex-direction: column; padding: 12rpx 12rpx 26rpx; }
.eyebrow { color: #73845f; font-size: 25rpx; font-weight: 600; letter-spacing: 2rpx; }
.headline { margin-top: 9rpx; color: #304d3c; font-size: 56rpx; font-weight: 700; }
.intro { margin-top: 10rpx; color: #68766a; font-size: 27rpx; }
/* 欢迎提示可跳过，之后由团团在伙伴卡继续提供轻量引导。 */
.welcome-card { display: flex; flex-direction: column; margin-bottom: 24rpx; padding: 24rpx 28rpx; border-radius: 28rpx; background: #fff4d9; }
.welcome-message { margin-top: 10rpx; color: #304d3c; font-size: 28rpx; line-height: 1.5; }
.welcome-action { align-self: flex-end; min-height: 76rpx; margin: 18rpx 0 0; padding: 0 26rpx; border-radius: 22rpx; background: #3d6b4c; color: #fff; font-size: 26rpx; }
.scene { position: relative; height: 420rpx; overflow: hidden; border-radius: 36rpx; background: linear-gradient(#a9d9d3, #d7eee1 72%, #e9e6bd); }
/* 新背景覆盖旧几何场景；旧场景在图片加载失败时自然显现。 */
.scene-image { position: absolute; z-index: 5; top: 0; left: 0; width: 100%; height: 100%; }
.sun { position: absolute; top: 38rpx; right: 70rpx; width: 86rpx; height: 86rpx; border-radius: 50%; background: #ffe2a4; }
.cloud { position: absolute; z-index: 1; width: 124rpx; height: 35rpx; border-radius: 40rpx; background: rgba(255,255,255,.8); }
.cloud-left { top: 75rpx; left: 52rpx; }
.cloud-right { top: 130rpx; right: 30rpx; width: 92rpx; }
.hill { position: absolute; bottom: -130rpx; width: 520rpx; height: 250rpx; border-radius: 50%; }
.hill-back { left: -120rpx; background: #a4c88d; }
.hill-front { right: -130rpx; background: #79af7b; }
.tree-trunk { position: absolute; z-index: 2; bottom: 48rpx; left: 310rpx; width: 86rpx; height: 225rpx; border-radius: 35rpx 35rpx 8rpx 8rpx; background: #8a5e41; }
.tree-canopy { position: absolute; z-index: 3; border-radius: 50%; background: #5b9c69; }
.canopy-left { top: 83rpx; left: 170rpx; width: 215rpx; height: 185rpx; }
.canopy-right { top: 93rpx; left: 340rpx; width: 220rpx; height: 182rpx; }
.canopy-top { top: 38rpx; left: 256rpx; width: 205rpx; height: 176rpx; background: #72b47b; }
.tree-house { position: absolute; z-index: 4; top: 188rpx; left: 265rpx; width: 178rpx; height: 132rpx; border: 8rpx solid #76553d; border-radius: 14rpx; background: #e2b477; box-sizing: border-box; }
.house-roof { position: absolute; top: -51rpx; left: -23rpx; width: 208rpx; height: 46rpx; border-radius: 35rpx 35rpx 6rpx 6rpx; background: #ab6c51; }
.house-window { position: absolute; top: 30rpx; left: 22rpx; width: 42rpx; height: 42rpx; border: 6rpx solid #76553d; border-radius: 50%; background: #f6dfa9; }
.house-door { position: absolute; bottom: 0; right: 23rpx; width: 45rpx; height: 75rpx; border-radius: 24rpx 24rpx 0 0; background: #76553d; }
.scene-label { position: absolute; z-index: 6; bottom: 20rpx; left: 24rpx; padding: 9rpx 18rpx; border-radius: 22rpx; background: rgba(255,255,255,.86); color: #304d3c; font-size: 21rpx; }
.pet-card, .task-card { margin-top: 28rpx; border-radius: 30rpx; background: #fffdf7; box-shadow: 0 8rpx 22rpx rgba(68,83,60,.07); }
.pet-card { display: flex; align-items: center; justify-content: space-between; min-height: 218rpx; padding: 28rpx 28rpx 28rpx 32rpx; }
.pet-copy { display: flex; flex: 1; flex-direction: column; padding-right: 15rpx; }
.section-label { color: #79936e; font-size: 24rpx; font-weight: 600; }
.pet-name { margin-top: 7rpx; color: #344a39; font-size: 39rpx; font-weight: 700; }
.pet-intro { margin-top: 7rpx; color: #6e796f; font-size: 23rpx; line-height: 1.45; }
.companion-message { margin-top: 12rpx; color: #3d6b4c; font-size: 24rpx; line-height: 1.45; }
.interaction-count { margin-top: 12rpx; color: #9a8065; font-size: 21rpx; }
.interaction-recovery { margin-top: 6rpx; color: #879087; font-size: 20rpx; line-height: 1.4; }
.pet-button { position: relative; flex: none; width: 160rpx; height: 160rpx; margin: 0; padding: 0; border-radius: 50%; background: #f3e0ba; }
/* 角色图保持独立路径，后续替换正式 PNG 不需重做点击区。 */
.character-image { display: block; width: 100%; height: 100%; }
.character-fallback { position: relative; width: 100%; height: 100%; }
.pet-ear { position: absolute; top: 14rpx; width: 54rpx; height: 54rpx; border-radius: 50%; background: #aa7d58; }
.ear-left { left: 12rpx; } .ear-right { right: 12rpx; }
.pet-face { position: absolute; top: 37rpx; left: 22rpx; width: 116rpx; height: 106rpx; border-radius: 48%; background: #bc906b; }
.pet-eye { position: absolute; top: 42rpx; width: 11rpx; height: 14rpx; border-radius: 50%; background: #463b33; }
.eye-left { left: 35rpx; } .eye-right { right: 35rpx; }
.pet-nose { position: absolute; top: 63rpx; left: 49rpx; width: 19rpx; height: 13rpx; border-radius: 50%; background: #694d42; }
.task-card { padding: 31rpx 32rpx; }
.task-heading { display: flex; align-items: center; justify-content: space-between; }
.task-count { color: #567d5b; font-size: 27rpx; font-weight: 700; }
.task-title { display: block; margin-top: 15rpx; font-size: 30rpx; font-weight: 650; }
.welcome-progress-label { display: block; margin-top: 12rpx; color: #67816a; font-size: 23rpx; }
.progress-track { height: 19rpx; margin-top: 26rpx; overflow: hidden; border-radius: 15rpx; background: #e3e9d9; }
.progress-fill { height: 100%; border-radius: 15rpx; background: #7dab79; }
.task-hint { display: block; margin-top: 17rpx; color: #7a887a; font-size: 22rpx; }
.story-guide { display: flex; flex-direction: column; gap: 8rpx; margin-top: 28rpx; padding: 20rpx 26rpx; border-radius: 24rpx; background: #eaf1e5; }
.story-status { color: #3d6b4c; font-size: 24rpx; font-weight: 700; }
.next-step { color: #415746; font-size: 25rpx; line-height: 1.45; }
.start-button { margin-top: 32rpx; height: 94rpx; border-radius: 30rpx; background: #5a8f69; color: #fff; font-size: 32rpx; font-weight: 700; line-height: 94rpx; }
/* 入口只负责导航，进度与角色状态由业务模块维护。 */
.quick-links { display: flex; gap: 20rpx; margin-top: 18rpx; }
.quick-links button { flex: 1; margin: 0; border-radius: 22rpx; background: #fffdf7; color: #4e7457; font-size: 26rpx; }
.dev-entry { margin-top: 36rpx; background: transparent; color: #8a8a8a; font-size: 21rpx; }
/* 成长效果叠加在既有场景上，使用原创样式，不依赖新增图片。 */
.growth-lights { position: absolute; z-index: 7; top: 53%; left: 34%; display: flex; justify-content: space-between; width: 29%; height: 14rpx; border-top: 3rpx solid #b48e45; }
.growth-lights-fallback { top: 45%; left: 39%; width: 26%; }
.growth-lamp { width: 14rpx; height: 20rpx; margin-top: -3rpx; border-radius: 50%; background: #fff7b9; box-shadow: 0 0 12rpx 7rpx rgba(255, 225, 120, .7); }
.window-glow { position: absolute; z-index: 6; top: 63%; left: 43%; width: 48rpx; height: 48rpx; transform: translate(-50%, -50%); border-radius: 50%; background: rgba(255, 237, 132, .55); box-shadow: 0 0 36rpx 22rpx rgba(255, 227, 120, .45); }
.window-glow-fallback { top: 59%; left: 46%; }
.growth-decorations { position: absolute; z-index: 7; top: 0; right: 0; bottom: 0; left: 0; }
.star-ornament { position: absolute; top: 58%; color: #fff2a1; font-size: 34rpx; text-shadow: 0 2rpx 4rpx #aa7f39; }
.star-ornament::before { content: ''; position: absolute; bottom: 100%; left: 50%; height: 22rpx; border-left: 2rpx solid #d6ae59; }
.ornament-left { left: 37%; }
.ornament-right { left: 58%; }
.growth-planter { position: absolute; left: 65%; bottom: 14%; width: 44rpx; height: 70rpx; }
.flower-stem { position: absolute; left: 22rpx; top: 16rpx; height: 30rpx; border-left: 4rpx solid #4f8254; }
.flower-head { position: absolute; top: -6rpx; left: 5rpx; color: #f59e91; font-size: 38rpx; }
.flower-pot { position: absolute; bottom: 0; width: 44rpx; height: 30rpx; border-radius: 4rpx 4rpx 12rpx 12rpx; background: #bc8057; }
.star-sparkle { position: absolute; z-index: 8; top: 15%; left: 48%; color: #fff5a0; font-size: 68rpx; text-shadow: 0 0 18rpx #edb644; animation: star-arrival 1.2s ease-out both; }
@keyframes star-arrival { from { opacity: 0; transform: translateY(70rpx) scale(.4); } 35% { opacity: 1; transform: translateY(0) scale(1.15); } to { opacity: 0; transform: translateY(-35rpx) scale(.8); } }
.star-feedback { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; padding: 20rpx 24rpx; border-radius: 22rpx; background: #fff1c9; color: #72512d; font-size: 25rpx; line-height: 1.5; }
.star-feedback-amount { flex: none; font-weight: bold; font-size: 30rpx; }
.growth-hint { margin: 16rpx 12rpx 0; color: #657c59; font-size: 23rpx; line-height: 1.5; }
