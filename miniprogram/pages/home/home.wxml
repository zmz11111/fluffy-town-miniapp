<!-- 首页先显示原创资源占位图；图片失败时仍保留原有图形场景。 -->
<view class="home">
  <view class="welcome">
    <text class="eyebrow">欢迎来到毛茸茸小镇</text>
    <text class="headline">团团的树屋</text>
    <text class="intro">和团团一起，寻找消失的星星饼干。</text>
  </view>

  <view class="scene" aria-label="毛茸茸树屋背景">
    <view class="sun"></view>
    <view class="cloud cloud-left"></view>
    <view class="cloud cloud-right"></view>
    <view class="hill hill-back"></view>
    <view class="hill hill-front"></view>
    <view class="tree-trunk"></view>
    <view class="tree-canopy canopy-left"></view>
    <view class="tree-canopy canopy-right"></view>
    <view class="tree-canopy canopy-top"></view>
    <view class="tree-house">
      <view class="house-roof"></view>
      <view class="house-window"></view>
      <view class="house-door"></view>
    </view>
    <image wx:if="{{!sceneImageFailed}}" class="scene-image" src="{{sceneSrc}}" mode="aspectFill" binderror="onSceneImageError" aria-label="毛茸茸树屋" />
    <view class="scene-label">毛茸茸树屋</view>
  </view>

  <view class="pet-card">
    <view class="pet-copy">
      <text class="section-label">你的伙伴</text>
      <text class="pet-name">{{pet.name}}</text>
      <text class="pet-intro">{{pet.introduction}}</text>
      <text class="interaction-count">和团团打个招呼 · 累计互动 {{interactionCount}} 次</text>
    </view>
    <button class="pet-button" bindtap="tapPet" aria-label="点击和团团互动">
      <image wx:if="{{!characterImageFailed}}" class="character-image" src="{{tuantuanVisual.src}}" mode="aspectFit" binderror="onCharacterImageError" aria-label="{{tuantuanVisual.alt}}" />
      <view wx:else class="character-fallback">
        <view class="pet-ear ear-left"></view>
        <view class="pet-ear ear-right"></view>
        <view class="pet-face">
          <view class="pet-eye eye-left"></view>
          <view class="pet-eye eye-right"></view>
          <view class="pet-nose"></view>
        </view>
      </view>
    </button>
  </view>

  <view class="task-card">
    <view class="task-heading">
      <text class="section-label">今日任务</text>
      <text class="task-count">{{completed}} / {{total}}</text>
    </view>
    <text class="task-title">认识树屋里的 6 个测试单词</text>
    <view class="progress-track"><view class="progress-fill" style="width: {{progressPercent}}%;"></view></view>
    <text class="task-hint" wx:if="{{completed < total}}">每学会一个词，就离小小冒险更近一步。</text>
    <text class="task-hint" wx:else>今天的示例单词都认识啦！</text>
  </view>

  <button class="start-button" bindtap="startAdventure">开始冒险</button>
  <view class="quick-links">
    <button bindtap="openFriends">伙伴</button>
    <button bindtap="openWords">单词卡</button>
  </view>
</view>

